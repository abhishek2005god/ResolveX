# ========================================================
# ResolveX - Environment Variables Configuration
# ========================================================

# Server Port
SERVER_PORT=8088

# Active Profile: local (H2 in-memory), dev (Postgres), prod (Docker Compose)
SPRING_PROFILES_ACTIVE=local

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resolvex
DB_USER=resolvex_user
DB_PASSWORD=resolvex_pass

# Security & JWT Token (Base64-encoded 256-bit secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload Directory
FILE_UPLOAD_DIR=./uploads

# Optional: Google Gemini API Key for External LLM Ticket Triage
# If left blank, the built-in local heuristic classification engine runs automatically.
GEMINI_API_KEY=
